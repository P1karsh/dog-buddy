{
  "manifest_version": 3,
  "name": "Dog Buddy",
  "version": "0.1.0",
  "description": "A tiny dog who lives on your pages: cheers you on, naps, and boops your Shorts, Reels and TikTok tabs closed.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Dog Buddy",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "panel/panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "idle", "sidePanel", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["shared/settings.js", "shared/sprite-meta.js", "shared/sprites.js", "content/dog.js"],
      "run_at": "document_idle"
    }
  ]
}
